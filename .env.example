# CORS Proxy Configuration for Production
#
# ⚠️  REQUIRED FOR PRODUCTION DEPLOYMENTS
#
# The app makes requests to SEC EDGAR, NPI Registry, and other APIs that enforce CORS policies.
# The Vite dev proxy (`/sec-arch`, `/sec-files`, `/npi-api`) only works during local development.
#
# For production (static SPA deployment), you MUST provide a backend CORS proxy or the app will fail.
#
# Option 1: Use a managed CORS proxy (slower, rate-limited, not recommended for production)
# Leave VITE_PROXY_URL unset and the app will fall back to public proxies (corsproxy.io, etc.)
# These are unreliable and may block high-volume requests.
#
# Option 2: Set up your own backend proxy (RECOMMENDED)
# 1. Deploy a simple proxy service (Node/Python/Go) that accepts:
#    GET /proxy?url=<url-encoded-target-url>
#    and forwards requests while adding CORS headers
# 2. Set VITE_PROXY_URL to your proxy endpoint:
#
# VITE_PROXY_URL=https://your-backend.example.com/proxy
#
# The proxy should:
# - Accept arbitrary target URLs in query params
# - Forward the request to the target
# - Add Access-Control-Allow-Origin: * header to responses
# - Optionally rate-limit and cache responses
#
# Example minimal Node.js backend proxy:
#   const express = require('express');
#   const fetch = require('node-fetch');
#   const app = express();
#   app.get('/proxy', async (req, res) => {
#     const targetUrl = req.query.url;
#     if (!targetUrl) return res.status(400).send('Missing url param');
#     try {
#       const response = await fetch(decodeURIComponent(targetUrl));
#       res.setHeader('Access-Control-Allow-Origin', '*');
#       res.send(await response.text());
#     } catch (e) {
#       res.status(500).send(e.message);
#     }
#   });
#   app.listen(3001);
